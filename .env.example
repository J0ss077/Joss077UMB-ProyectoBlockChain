# Credenciales PostgreSQL. Copiar a .env y ajustar valores.
# .env no se versiona; este archivo sí, y es la plantilla de referencia.
POSTGRES_USER=blockchain_user
POSTGRES_PASSWORD=blockchain_secret
POSTGRES_DB=blockchain_db
POSTGRES_PORT=5432

# URI que consumirá el backend cuando exista.
# El host es localhost porque el backend correrá en la máquina anfitriona y el
# contenedor publica el puerto en POSTGRES_PORT. Si el backend llegara a correr
# dentro de la red de Docker Compose, el host sería db y el puerto sería 5432.
DATABASE_URL=postgresql://blockchain_user:blockchain_secret@localhost:5432/blockchain_db
