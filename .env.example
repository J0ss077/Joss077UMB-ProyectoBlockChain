# Plantilla del entorno local (REQ-21). Se copia a `.env`, que está en
# `.gitignore` y nunca se versiona: `.env` lleva los secretos de verdad.
#
# MASTER_KEY cifra el material privado de las wallets (decisión 3 del diseño):
# con ella se descifra la llave privada para firmar, así que perderla deja
# ilegibles las wallets ya registradas y filtrarla compromete su material.
# Se genera con:
#   .venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# La de abajo es una clave Fernet de ejemplo y no la del proyecto: reemplácela en
# su `.env` por la que genere con el comando de arriba.
POSTGRES_USER=blockchain_user
POSTGRES_PASSWORD=blockchain_password
POSTGRES_DB=blockchain_db
POSTGRES_PORT=5432

# Cadena de conexión que usan la aplicación y las pruebas de integración.
# El puerto debe coincidir con POSTGRES_PORT.
DATABASE_URL=postgresql://blockchain_user:blockchain_password@localhost:5432/blockchain_db

MASTER_KEY=RtfRggruLjYRHa_ksPa6avdIeFJKjbZxxmNCD0Ym1UU=
